{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "utm_source"
        }
      ],
      "destination": "/:path*",
      "permanent": false,
      "preserveQueryParams": false
    }
  ]
}
